{
  "name": "tinkerdesk-provider-speech-sherpa",
  "version": "0.2.0",
  "description": "TinkerDesk \u63d2\u4ef6\uff1a\u672c\u5730\u79bb\u7ebf\u8bed\u97f3 STT + TTS\uff08Sherpa-ONNX\uff09",
  "main": "dist/index.js",
  "scripts": {
    "pack": "node scripts/pack.js",
    "verify": "node scripts/verify.js",
    "build": "npm run typecheck && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "node-cpal": "0.1.1",
    "sherpa-onnx-node": "1.13.4"
  },
  "overrides": {
    "sherpa-onnx-darwin-arm64": "1.13.4",
    "sherpa-onnx-darwin-x64": "1.13.4",
    "sherpa-onnx-linux-arm64": "1.13.4",
    "sherpa-onnx-linux-x64": "1.13.4",
    "sherpa-onnx-win-x64": "1.13.4",
    "sherpa-onnx-win-ia32": "1.13.4"
  },
  "files": [
    "dist/",
    "manifest.json",
    "core/",
    "scripts/",
    "guide.md",
    "README.md"
  ],
  "keywords": [
    "stt",
    "tinkerdesk-provider",
    "tts",
    "voice"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
