{
  "id": "speech-omni-voice",
  "name": "语音克隆（OmniVoice）",
  "version": "0.2.0",
  "apiVersion": 1,
  "entry": "dist/index.js",
  "requiresMain": true,
  "capabilities": [
    "tts",
    "voice-clone"
  ],
  "systemInterfaces": [
    {
      "id": "voice.tts",
      "version": 1
    },
    {
      "id": "tool.tts",
      "version": 1
    }
  ],
  "permissions": [
    "audio-output"
  ],
  "description": "用你自己的声音朗读（零样本声音克隆 TTS，OmniVoice 引擎，需要本机 GPU）",
  "assetDeps": [
    {
      "name": "OmniVoice 模型（声音克隆）",
      "dest": "models/OmniVoice",
      "sizeMB": 2048,
      "url": "https://hf-mirror.com/k2-fsa/OmniVoice"
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "voiceProfile": {
        "type": "file",
        "title": "参考音色（仿声）",
        "placeholder": "请选择一个音频文件（*.mp3 或 *.wav）",
        "default": "",
        "filters": [
          {
            "name": "音频文件",
            "extensions": [
              "wav",
              "mp3",
              "flac",
              "m4a"
            ]
          }
        ],
        "description": "用这段参考音频的声音朗读（建议 5-10 秒清晰人声）"
      },
      "refText": {
        "type": "string",
        "title": "参考音频原文（必填）",
        "placeholder": "请输入音频原文以校准音色",
        "description": "参考音频说了什么？本机 Whisper 离线不可用，必须手动填写原文（影响克隆音色质量）"
      },
      "speed": {
        "type": "number",
        "title": "语速",
        "min": 0.5,
        "max": 2,
        "step": 0.1,
        "default": 1
      }
    }
  }
}